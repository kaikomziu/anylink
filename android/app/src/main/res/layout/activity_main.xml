<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ヘッダー -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="AnyLink"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/statusDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="6dp"
            android:background="@color/warn" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="150dp"
            android:text="接続中…"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/settingsBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="設定"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="@color/text" />
    </LinearLayout>

    <!-- 操作されている帯 -->
    <LinearLayout
        android:id="@+id/hostBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#3A1414"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hostBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="操作されています"
            android:textColor="#FFD6D6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hostDisconnect"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/danger"
            android:text="切断"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 自分のID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/CardLabel"
                    android:text="このデバイスのID" />

                <TextView
                    android:id="@+id/myId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.08"
                    android:text="--- --- ---"
                    android:textColor="@color/text"
                    android:textIsSelectable="true"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/myName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sub"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copyId"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="IDをコピー" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="このIDを相手に伝えると、相手からの接続要求を受けられます。接続されるときは必ず許可の確認が表示されます。"
                    android:textColor="@color/sub"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- 操作の受け入れ準備 -->
            <LinearLayout
                android:id="@+id/setupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/CardLabel"
                    android:text="操作を受け入れる準備" />

                <TextView
                    android:id="@+id/setupText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/warn"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ユーザー補助を開く" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/grantNotify"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="通知を許可する" />
            </LinearLayout>

            <!-- 接続 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/CardLabel"
                    android:text="リモートデバイスに接続" />

                <EditText
                    android:id="@+id/remoteId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/input_bg"
                    android:digits="0123456789 "
                    android:hint="相手のIDを入力"
                    android:imeOptions="actionGo"
                    android:inputType="number"
                    android:letterSpacing="0.08"
                    android:maxLength="11"
                    android:padding="14dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/sub"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="希望する権限"
                    android:textColor="@color/sub"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/reqControl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="操作" />

                    <CheckBox
                        android:id="@+id/reqKeyboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="キーボード" />

                    <CheckBox
                        android:id="@+id/reqClipboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="クリップボード" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connectBtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:text="接続"
                    android:textSize="16sp" />

                <TextView
                    style="@style/CardLabel"
                    android:layout_marginTop="14dp"
                    android:text="最近の接続" />

                <LinearLayout
                    android:id="@+id/recentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
