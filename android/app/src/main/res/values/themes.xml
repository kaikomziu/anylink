<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AnyLink" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="colorSurface">@color/panel</item>
    </style>

    <style name="Theme.AnyLink.Dialog" parent="Theme.Material3.Dark.Dialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="Theme.AnyLink.Fullscreen" parent="Theme.AnyLink">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
